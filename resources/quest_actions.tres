[gd_resource type="OpenXRActionMap" load_steps=30 format=3]

[sub_resource type="OpenXRAction" id="grip"]
resource_name = "grip"
localized_name = "grip"
action_type = 3
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRIPBinding" id="binding_grip_left"]
action = SubResource("grip")
binding_path = "/user/hand/left/input/grip/pose"

[sub_resource type="OpenXRIPBinding" id="binding_grip_right"]
action = SubResource("grip")
binding_path = "/user/hand/right/input/grip/pose"

[sub_resource type="OpenXRAction" id="aim"]
resource_name = "aim"
localized_name = "aim"
action_type = 3
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRIPBinding" id="binding_aim_left"]
action = SubResource("aim")
binding_path = "/user/hand/left/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="binding_aim_right"]
action = SubResource("aim")
binding_path = "/user/hand/right/input/aim/pose"

[sub_resource type="OpenXRAction" id="grip_value"]
resource_name = "grip_value"
localized_name = "grip value"
action_type = 1
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRIPBinding" id="binding_grip_value_left"]
action = SubResource("grip_value")
binding_path = "/user/hand/left/input/squeeze/value"

[sub_resource type="OpenXRIPBinding" id="binding_grip_value_right"]
action = SubResource("grip_value")
binding_path = "/user/hand/right/input/squeeze/value"

[sub_resource type="OpenXRAction" id="trigger_value"]
resource_name = "trigger_value"
localized_name = "trigger value"
action_type = 1
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRIPBinding" id="binding_trigger_value_left"]
action = SubResource("trigger_value")
binding_path = "/user/hand/left/input/trigger/value"

[sub_resource type="OpenXRIPBinding" id="binding_trigger_value_right"]
action = SubResource("trigger_value")
binding_path = "/user/hand/right/input/trigger/value"

[sub_resource type="OpenXRAction" id="move"]
resource_name = "move"
localized_name = "move"
action_type = 2
toplevel_paths = PackedStringArray("/user/hand/left")

[sub_resource type="OpenXRIPBinding" id="binding_move_left"]
action = SubResource("move")
binding_path = "/user/hand/left/input/thumbstick"

[sub_resource type="OpenXRAction" id="turn"]
resource_name = "turn"
localized_name = "turn"
action_type = 2
toplevel_paths = PackedStringArray("/user/hand/right")

[sub_resource type="OpenXRIPBinding" id="binding_turn_right"]
action = SubResource("turn")
binding_path = "/user/hand/right/input/thumbstick"

[sub_resource type="OpenXRAction" id="sprint"]
resource_name = "sprint"
localized_name = "sprint"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/left")

[sub_resource type="OpenXRIPBinding" id="binding_sprint_left"]
action = SubResource("sprint")
binding_path = "/user/hand/left/input/thumbstick/click"

[sub_resource type="OpenXRAction" id="menu"]
resource_name = "menu"
localized_name = "menu"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/left")

[sub_resource type="OpenXRIPBinding" id="binding_menu_left"]
action = SubResource("menu")
binding_path = "/user/hand/left/input/menu/click"

[sub_resource type="OpenXRAction" id="stats"]
resource_name = "stats"
localized_name = "stats"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/left")

[sub_resource type="OpenXRIPBinding" id="binding_stats_left"]
action = SubResource("stats")
binding_path = "/user/hand/left/input/x/click"

[sub_resource type="OpenXRAction" id="interact"]
resource_name = "interact"
localized_name = "interact"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/right")

[sub_resource type="OpenXRIPBinding" id="binding_interact_right"]
action = SubResource("interact")
binding_path = "/user/hand/right/input/a/click"

[sub_resource type="OpenXRAction" id="haptic"]
resource_name = "haptic"
localized_name = "haptic"
action_type = 4
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRIPBinding" id="binding_haptic_left"]
action = SubResource("haptic")
binding_path = "/user/hand/left/output/haptic"

[sub_resource type="OpenXRIPBinding" id="binding_haptic_right"]
action = SubResource("haptic")
binding_path = "/user/hand/right/output/haptic"

[sub_resource type="OpenXRActionSet" id="gameplay"]
resource_name = "gameplay"
localized_name = "Awakening"
actions = [SubResource("grip"), SubResource("aim"), SubResource("grip_value"), SubResource("trigger_value"), SubResource("move"), SubResource("turn"), SubResource("sprint"), SubResource("menu"), SubResource("stats"), SubResource("interact"), SubResource("haptic")]

[sub_resource type="OpenXRInteractionProfile" id="touch"]
interaction_profile_path = "/interaction_profiles/oculus/touch_controller"
bindings = [SubResource("binding_grip_left"), SubResource("binding_grip_right"), SubResource("binding_aim_left"), SubResource("binding_aim_right"), SubResource("binding_grip_value_left"), SubResource("binding_grip_value_right"), SubResource("binding_trigger_value_left"), SubResource("binding_trigger_value_right"), SubResource("binding_move_left"), SubResource("binding_turn_right"), SubResource("binding_sprint_left"), SubResource("binding_menu_left"), SubResource("binding_stats_left"), SubResource("binding_interact_right"), SubResource("binding_haptic_left"), SubResource("binding_haptic_right")]

[resource]
action_sets = [SubResource("gameplay")]
interaction_profiles = [SubResource("touch")]
